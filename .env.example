# Majburiy: @BotFather bergan token
BOT_TOKEN=123456:replace_with_botfather_token
# Admin Telegram ID lari (vergul bilan). ID ni bilish uchun botga /id yuboring.
ADMIN_IDS=123456789

# --- Docker (compose.standalone.yml) uchun ---
# Parol yarating: openssl rand -hex 24  (faqat harf/raqam bo'lsin)
# POSTGRES_PASSWORD=

# --- Docker'siz ishlatish ---
# Hech narsa yozmasangiz bot SQLite ishlatadi (data/bot.sqlite).
# DATABASE_PATH=./data/bot.sqlite

# --- Tashqi PostgreSQL ishlatmoqchi bo'lsangiz ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname
